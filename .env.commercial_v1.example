# GEOX Commercial v1 local acceptance/runtime template.
#
# Copy this file to `.env` for local controlled runtime validation only.
# Do not use these weak local values in production.
# Do not commit `.env`.

POSTGRES_USER=landos
POSTGRES_PASSWORD=landos_pwd
POSTGRES_DB=landos

GEOX_MCFT_MIGRATOR_PASSWORD=local-mcft-migrator-password
GEOX_RUNTIME_DATABASE_PASSWORD=local-runtime-database-password
GEOX_TELEMETRY_DATABASE_PASSWORD=local-telemetry-database-password
GEOX_JOBS_DATABASE_PASSWORD=local-jobs-database-password
GEOX_EXECUTOR_DATABASE_PASSWORD=local-executor-database-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

GEOX_AO_ACT_TOKEN=admin_token
GEOX_TOKEN=admin_token
GEOX_EXECUTOR_TOKEN=executor_token

GEOX_TELEMETRY_MQTT_USERNAME=geox_telemetry_ingest_v1
GEOX_TELEMETRY_MQTT_PASSWORD=local-telemetry-mqtt-password
GEOX_EXECUTOR_MQTT_USERNAME=geox_executor_v1
GEOX_EXECUTOR_MQTT_PASSWORD=local-executor-mqtt-password

GEOX_EVIDENCE_S3_BUCKET=evidence-exports-v1
GEOX_EVIDENCE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
