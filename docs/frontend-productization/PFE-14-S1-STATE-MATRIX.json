    {"state":"RUNNING","kind":"operational","http_status":200,"zh_title":"当前时隙运行中","en_title":"Current slot is running","safe_action":"READ_ONLY_REFRESH","auto_retry":"SERVER_RECOMMENDED","claims_allowed":["server reports an active tick"],"claims_forbidden":["progress inferred from elapsed browser time"]},
