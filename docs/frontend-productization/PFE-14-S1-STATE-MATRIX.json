    {"state":"API_ERROR","kind":"transport_error","http_status":[400,409,503,500],"zh_title":"无法读取 Runtime","en_title":"Runtime could not be read","safe_action":"RETRY_OR_COPY_REQUEST_ID","auto_retry":"POLICY_LIMITED","claims_allowed":["request failed with exact error code"],"claims_forbidden":["convert error into empty data","display raw secrets"]}
