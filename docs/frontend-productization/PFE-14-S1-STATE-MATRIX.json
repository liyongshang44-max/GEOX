    {"state":"DEGRADED_STALE_EVIDENCE","kind":"degraded","http_status":200,"zh_title":"Evidence 已陈旧，运行结果受限","en_title":"Evidence is stale; runtime output is limited","safe_action":"OPEN_EVIDENCE_DETAILS","auto_retry":"SERVER_RECOMMENDED","claims_allowed":["server freshness verdict is stale"],"claims_forbidden":["frontend threshold determined staleness","forecast is recommendation"]},
