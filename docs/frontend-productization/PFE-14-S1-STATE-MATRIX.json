  "composition_rules": [
    "BACKFILLING may include stale-evidence as a secondary condition but remains the primary state",
    "RECOVERED is shown only when recovery_status equals RECOVERED; restart_detected alone is insufficient",
    "COMPLETED does not override DEGRADED states when the completed slot used stale or missing Evidence",
    "RUNTIME_NOT_ESTABLISHED is not an EMPTY success state",
