{
  "phase": "B-10A",
  "title": "Residual Authority Audit V1",
  "enforcement_model": {
    "scope": "REPOSITORY_WIDE_AUTHORITY_CAPABLE_SURFACES",
    "unregistered_authority_capable_path": "FAIL",
    "business_behavior_change": "FORBIDDEN",
    "mcft_implementation_change": "FORBIDDEN"
  },
  "scan_policy": {
    "roots": [
      "apps/server/src",
      "apps/server/db/migrations",
      "apps/executor/src",
      "packages/contracts/src",
      "scripts/runtime_acceptance",
      "scripts/governance_acceptance",
      ".github/workflows"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".cjs",
      ".mjs",
      ".sql",
      ".yml",
      ".yaml"
    ],
    "ignore_path_fragments": [
      "node_modules",
      "/dist/",
      ".test.",
      "/__tests__/",
      "/fixtures/"
    ]
  },
  "required_surface_fields": [
    "path",
    "entrypoint",
    "activation_mode",
    "writes",
    "reads",
    "semantic_family",
    "authority_class",
    "semantic_role",
    "runtime_reachable",
    "feature_flag",
    "downstream_consumers",
    "removal_target",
    "current_tree",
    "detection_required"
  ],
  "detectors": [
    {
      "detector_id": "D-CANDIDATE-PERSISTED-WRITER",
      "semantic_family": "decision.candidate",
      "kind": "PERSISTED_WRITER",
      "all_of": [
        "decision_recommendation_v1"
      ],
      "capability_any_of": [
        "INSERT INTO facts",
        "insertFact(",
        "appendFact(",
        "appendSkillRunFact("
      ]
    },
    {
      "detector_id": "D-CANDIDATE-PURE-BUILDER",
      "semantic_family": "decision.candidate",
      "kind": "SEMANTIC_BUILDER",
      "any_of": [
        "CandidateDecisionV1",
        "CandidateActionV1",
        "CANDIDATE_ONLY"
      ],
      "capability_any_of": [
        "re:export\\s+(?:async\\s+)?function\\s+(?:build|compile|project|create)",
        "Schema.parse(",
        "Schema.safeParse("
      ]
    },
    {
      "detector_id": "D-APPROVAL-WRITER",
      "semantic_family": "decision.approval",
      "kind": "PERSISTED_WRITER",
      "any_of": [
        "approval_request_v1",
        "approval_decision_v1"
