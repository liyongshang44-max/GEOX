    {
      "detector_id": "D-EXECUTOR-DISPATCH-AUTHORITY",
      "semantic_family": "execution.dispatch_delivery",
      "kind": "EXECUTOR_ADAPTER_RUNTIME",
      "all_of": [
        "writeDispatchState",
        "adapter.execute"
