      "detector_id": "D-SQL-AUTHORITY-FUNCTION-TRIGGER",
      "semantic_family": "database.authority_logic",
      "kind": "SQL_FUNCTION_OR_TRIGGER",
      "any_of": [
        "decision_recommendation",
        "approval_",
        "operation_plan",
        "ao_act",
        "dispatch",
        "receipt",
        "as_executed",
        "acceptance",
        "field_memory",
        "roi_"
      ],
      "capability_any_of": [
        "CREATE FUNCTION",
        "CREATE OR REPLACE FUNCTION",
        "CREATE TRIGGER",
        "EXECUTE FUNCTION"
      ]
    }
