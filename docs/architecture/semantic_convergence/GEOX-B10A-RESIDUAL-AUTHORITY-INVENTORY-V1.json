        "READY_FOR_APPROVAL"
      ]
    },
    {
      "detector_id": "D-OPERATION-PLAN-WRITER",
      "semantic_family": "operation.plan",
      "kind": "PERSISTED_WRITER",
      "all_of": [
        "operation_plan_v1"
      ],
      "capability_any_of": [
        "INSERT INTO facts",
        "insertFact(",
        "createOperationPlanFromRecommendation",
        "buildOperationPlan"
      ]
    },
    {
      "detector_id": "D-TASK-WRITER",
      "semantic_family": "execution.task",
      "kind": "TASK_PRODUCER",
      "all_of": [
        "ao_act_task_v0"
      ],
      "capability_any_of": [
        "INSERT INTO facts",
        "insertFact(",
        "buildAoActTask",
        "createTask"
      ]
