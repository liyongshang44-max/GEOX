      "capability_any_of": [
        "INSERT INTO facts",
        "insertFact(",
        "appendFact(",
        "createApprovalRequestV1("
      ]
    },
    {
      "detector_id": "D-PRESCRIPTION-AUTHORITY",
      "semantic_family": "action.specification",
      "kind": "PERSISTED_OR_POLICY_SURFACE",
