    "if_required_criteria_contains_ACTION_WINDOW": "action_window_policy MUST be non-null and valid",
    "if_required_criteria_excludes_ACTION_WINDOW": "action_window_policy MUST be null",
    "reason": "prevent unused or hidden actionability authority from being carried by policies that do not require ACTION_WINDOW"
  },
  "unit_and_representation_adjudication": {
