      "rule": "EVERY_COMPLETE_OR_EFFECTIVE_CAPABILITY_MUST_HAVE_EXPECTED_OWNER_EXPECTED_ROOT_STATIC_REACHABILITY_AND_REQUIRED_RUNTIME_PROOF",
