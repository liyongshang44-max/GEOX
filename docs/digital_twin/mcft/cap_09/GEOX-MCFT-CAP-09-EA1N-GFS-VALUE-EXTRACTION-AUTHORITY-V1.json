    {"role":"PRECIPITATION_RATE_SURFACE","filter_variable":"PRATE","filter_level":"surface","provider_unit":"kg_per_m2_per_s","normalized_unit":"mm_per_hour"}
  ],
  "tick_cycle_and_lead_policy": {
    "tick_boundary": "FLOOR_EXACT_PROBE_START_TO_UTC_HOUR",
    "canonical_point_count": 72,
    "canonical_valid_time_rule": "point[i].valid_time=T+(i+1)h",
    "candidate_cycle_hours_utc": [0, 6, 12, 18],
    "candidate_order": "NEWEST_TO_OLDEST",
    "lead_start_rule": "lead_start=(T-cycle_time)+1h",
    "lead_end_rule": "lead_end=(T-cycle_time)+72h",
    "derivation_support_rule": "support_lead=lead_start-1",
    "selected_cycle_requires_all_support_and_target_production_grib_and_idx_objects_last_modified_lte_tick": true,
    "missing_last_modified": "FAIL_CLOSED",
    "wait_for_future_files": false,
    "valid_time_rewrite": false,
    "support_lead_is_canonical_point": false
  },
  "decoded_message_reconciliation": {
    "every_message_must_match_selected_cycle_reference_time": true,
    "every_message_must_match_requested_provider_lead": true,
    "every_message_valid_time_must_equal_cycle_plus_end_step": true,
    "instantaneous_roles": ["AIR_TEMPERATURE_2M","RELATIVE_HUMIDITY_2M","U_WIND_10M","V_WIND_10M"],
    "instantaneous_step_type_required": "instant",
    "rolling_average_roles": ["DOWNWARD_SHORTWAVE_SURFACE","PRECIPITATION_RATE_SURFACE"],
    "rolling_average_step_type_required": "avg",
    "rolling_block_hours": 6,
    "rolling_start_rule": "S=6*floor((lead-1)/6)",
    "rolling_end_rule": "E=lead",
    "exactly_one_matching_average_record_per_role_per_lead": true,
    "unmatched_or_ambiguous_message": "FAIL_CLOSED"
  },
  "normalization": {
    "temperature": "degC=K-273.15",
    "relative_humidity": "DIRECT_PERCENT_NO_CLIP",
    "wind_10m": "speed10=sqrt(U10^2+V10^2)",
    "wind_2m": "speed2=speed10*0.747951075",
    "dswrf_when_L_eq_1": "hourly_mean_Wm2=A_S_E",
    "dswrf_when_L_gt_1": "hourly_mean_Wm2=L*A_S_E-(L-1)*A_S_Eminus1",
    "solar_for_future_et0": "Rs_MJ_m2_h=hourly_mean_Wm2*0.0036",
    "prate_when_L_eq_1": "hourly_mean_rate=R_S_E",
    "prate_when_L_gt_1": "hourly_mean_rate=L*R_S_E-(L-1)*R_S_Eminus1",
    "precipitation_depth": "mm_per_hour=hourly_mean_rate_kg_m2_s*3600",
    "cross_block_differencing": false,
    "missing_predecessor_imputation": false,
    "negative_derived_value_clipping": false
